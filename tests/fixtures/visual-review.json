    {
      "id": "03-long-label-architecture",
      "origin": "Synthetic acceptance fixture, not claims about a production system.",
      "checks": [
        "long-chinese-labels",
        "group-titles",
        "cross-group-edges"
      ],
      "spec": {
        "kind": "architecture",
        "title": "只有完成核验的请求才能进入执行服务",
        "summary": "验收用合成架构：输入校验、任务执行与结果审计分属不同边界。",
        "groups": [
          {
            "id": "input",
            "label": "输入与身份核验",
            "tone": "definition"
          },
          {
            "id": "execution",
            "label": "任务执行与失败恢复",
            "tone": "execution"
          },
          {
            "id": "audit",
            "label": "结果保存与审计追踪",
            "tone": "evidence"
          }
        ],
        "nodes": [
          {
            "id": "request",
            "label": "来自中文文档的结构化处理请求",
            "detail": "保留原始限定条件与版本标识",
            "group": "input"
          },
          {
            "id": "check",
            "label": "检查身份、权限和输入完整性",
            "group": "input"
          },
          {
            "id": "run",
            "label": "执行已获授权的处理步骤",
            "detail": "只处理当前请求对应的对象",
            "group": "execution"
          },
          {
            "id": "retry",
            "label": "失败后重试当前步骤",
            "detail": "已完成步骤保持不变",
            "group": "execution",
            "tone": "risk"
          },
          {
            "id": "save",
            "label": "写入经过核验的处理结果",
            "group": "audit"
          },
          {
            "id": "trace",
            "label": "记录来源、时间与处理版本",
            "group": "audit"
          }
        ],
        "edges": [
          {
            "from": "request",
            "to": "check",
            "label": "提交核验"
          },
          {
            "from": "check",
            "to": "run",
            "label": "核验通过"
          },
          {
            "from": "run",
            "to": "retry",
            "label": "暂时失败"
          },
          {
            "from": "retry",
            "to": "run",
            "label": "再次执行"
          },
          {
            "from": "run",
            "to": "save",
            "label": "结果有效"
          },
          {
            "from": "check",
            "to": "trace",
            "label": "保留核验依据"
          },
          {
            "from": "save",
            "to": "trace",
            "label": "关联版本"
          }
        ]
      }
    },
