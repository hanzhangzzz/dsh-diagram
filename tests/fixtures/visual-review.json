  "cases": [
    {
      "id": "01-release-flow",
      "origin": "Frozen from the publicly documented 0.5.0 first-use case; facts and wording unchanged.",
      "checks": [
        "long-flow-readability",
        "all-labels-preserved",
        "branches"
      ],
      "spec": {
        "kind": "flow",
        "title": "从修复到可安装",
        "summary": "Coding Usage Bar 0.5.1 的发布链：只有确认公开版本可安装、且公开包与已验证包一致之后，才宣布发布完成。",
        "nodes": [
          {
            "id": "accept",
            "label": "接受原贡献并跑通测试",
            "detail": "外部贡献者提交 PR #6，修复 GLM Coding Plan 配额解析（部分账号返回 CREDIT_LIMIT，旧版只识别 TOKENS_LIMIT）；维护者接受原贡献、合入后 139 项测试通过",
            "tone": "execution",
            "variant": "card"
          },
          {
            "id": "build",
            "label": "构建并验证同一个包",
            "detail": "只构建一次安装包并记录 SHA-256；先在隔离环境验证命令与配额解析，再在实际 macOS 环境安装，核对运行文件、菜单栏插件与定时任务，已有配置保留",
            "tone": "definition",
            "variant": "card"
          },
          {
            "id": "publish",
            "label": "npm 接收上传",
            "detail": "npm publish 返回成功；此时 registry 仍显示旧版本",
            "tone": "external",
            "variant": "card"
          },
          {
            "id": "gate",
            "label": "检查公开版本是否可用",
            "detail": "指定安装 0.5.1 返回版本不存在；npm 在新包可安装前进行发布时扫描，所以“上传被接收”与“公开可安装”是两个不同状态",
            "tone": "risk",
            "variant": "card",
            "icon": "search"
          },
          {
            "id": "wait",
            "label": "等待后重试",
            "detail": "不反复上传新版本，保留已经验证过的同一个包，继续等待 registry 能读到 0.5.1",
            "tone": "neutral",
            "variant": "card",
            "icon": "loop"
          },
          {
            "id": "hash",
            "label": "下载并核对哈希",
            "detail": "版本可读取后，下载公开 tarball 并核对 SHA-256；哈希一致才继续",
            "tone": "evidence",
            "variant": "card",
            "icon": "shield"
          },
          {
            "id": "install",
            "label": "从公开入口重新安装",
            "detail": "用全新 npm 缓存从公开 registry 安装 0.5.1；公开包中的 GLM credit 样例得到五小时 33%、一周 6% 的预期结果（测试样例值），运行文件与批准的包一致，菜单栏与定时任务通过检查",
            "tone": "evidence",
            "variant": "card",
            "icon": "person"
          },
          {
            "id": "release",
            "label": "tag、Release 与 CI 完成",
            "detail": "合入版本 PR #9，创建 v0.5.1 tag 与 GitHub Release，附同一安装包和校验文件；GitHub 下载包、npm 下载包与最初验证的包一致，合入与 tag 的 CI 均通过，才宣布发布完成",
            "tone": "target",
            "variant": "solid",
            "icon": "target"
          }
        ],
        "edges": [
          {
            "from": "accept",
            "to": "build",
            "label": "修复合入后"
          },
          {
            "from": "build",
            "to": "publish",
            "label": "同一个包"
          },
          {
            "from": "publish",
            "to": "gate"
          },
          {
            "from": "gate",
            "to": "wait",
            "label": "版本不可用"
          },
          {
            "from": "wait",
            "to": "gate",
            "label": "重试"
          },
          {
            "from": "gate",
            "to": "hash",
            "label": "可读取"
          },
          {
            "from": "hash",
            "to": "install",
            "label": "哈希一致"
          },
          {
            "from": "install",
            "to": "release",
            "label": "复核通过"
          }
        ]
      }
    },
